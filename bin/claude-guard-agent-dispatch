#!/usr/bin/env bash
# Claude Code PreToolUse(Agent) guard.
#
# CLAUDE.md rule made deterministic: a generic subagent dispatch (no
# subagent_type, or a general-purpose/claude one) must set `model` explicitly —
# an omitted model silently runs mechanical work on the session's (most
# expensive) model. Typed agents that pin their own model (Explore,
# claude-code-guide, plugin agents) and forks (which always inherit the parent
# model) are exempt.
#
# Receives the hook payload as JSON on stdin; exit 2 blocks the dispatch.
# Fails open (exit 0) on unparseable input — it is a guard, not the only gate.
set -euo pipefail

input="$(cat)"
verdict="$(
  printf '%s' "$input" | python3 -c '
import json, sys
try:
    ti = json.load(sys.stdin).get("tool_input", {})
except Exception:
    print("allow"); raise SystemExit
stype = (ti.get("subagent_type") or "").strip().lower()
model = (ti.get("model") or "").strip()
generic = stype in ("", "general-purpose", "claude")
print("deny" if generic and not model else "allow")
' 2>/dev/null || echo allow
)"

if [ "$verdict" = "deny" ]; then
  echo "Blocked by claude-guard-agent-dispatch: generic subagent dispatch without an explicit model - set model (usually \"sonnet\" for fully-specified work) per CLAUDE.md's model-selection rules, or use a typed agent that pins its own." >&2
  exit 2
fi
exit 0
