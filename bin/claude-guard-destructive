#!/usr/bin/env bash
# Claude Code PreToolUse(Bash) guard.
#
# Blocks "download a remote script and run it in a shell" — curl/wget feeding
# a shell, in any of its common forms, which a static permissions.deny glob
# can't reliably match:
#   curl URL | sh                 (pipe)
#   wget -O- URL | sudo bash      (pipe, privileged)
#   bash <(curl URL)              (process substitution)
#   sh -c "$(curl URL)"           (command substitution)
#   eval "$(curl URL)"            (eval of command substitution)
#
# Destructive commands like `rm -rf /`, `sudo`, and force-push are denied
# separately via permissions.deny in settings.json (and Claude Code has a
# built-in circuit breaker for `rm -rf /`); this hook is defense in depth for
# the fetch-and-execute pattern specifically.
#
# Receives the hook payload as JSON on stdin; exit 2 blocks the tool call.
# Fails open (exit 0) on unparseable input — it is a guard, not the only gate.
set -euo pipefail

input="$(cat)"
cmd="$(
  printf '%s' "$input" | python3 -c \
    'import json,sys; print(json.load(sys.stdin).get("tool_input",{}).get("command",""))' \
    2>/dev/null || true
)"

# A downloader (curl/wget) combined with any shell-execution construct.
if printf '%s' "$cmd" | grep -Eq \
  '(curl|wget)[^|]*\|[[:space:]]*(sudo[[:space:]]+)?(ba|z)?sh|(ba|z)?sh[[:space:]]+(-[a-z]+[[:space:]]+)*<\([[:space:]]*(curl|wget)|(ba|z)?sh[[:space:]]+-c[[:space:]]*["'"'"']?\$\([[:space:]]*(curl|wget)|eval[[:space:]]*["'"'"']?\$\([[:space:]]*(curl|wget)'; then
  echo "Blocked by claude-guard-destructive: fetching a remote script straight into a shell is denied." >&2
  exit 2
fi

# Bare force-push. permissions.deny can only glob `git push -f*`; the long-form
# `--force` needs a negative match against `--force-with-lease`, which globs
# can't express — so it lives here. The flag must appear in the same command
# segment (no |;& between) as `git push`, so flags in unrelated commands or
# later pipeline stages don't false-positive. `--force-with-lease` passes.
if printf '%s' "$cmd" | grep -Eq \
  'git[[:space:]]+push[^|;&]*[[:space:]](--force|-[a-eg-z]*f[a-eg-z]*)($|[[:space:]])'; then
  echo "Blocked by claude-guard-destructive: bare force-push is denied; use git push --force-with-lease on your own branch." >&2
  exit 2
fi

# Conventional-commit format (backstop for the CLAUDE.md rule; the prose tells
# Claude what to write, this catches drift). Only checked when an inline -m
# message is extractable; amend/fixup/merge and unextractable forms fail open.
if printf '%s' "$cmd" | grep -Eq 'git[[:space:]]+commit' &&
   ! printf '%s' "$cmd" | grep -Eq -- '--amend|--fixup|--squash|--allow-empty-message'; then
  msg="$(printf '%s' "$cmd" | grep -oE -- '-m[[:space:]]+["'"'"'][^"'"'"']+' | head -1 | sed -E 's/^-m[[:space:]]+["'"'"']//')"
  if [ -n "$msg" ] && ! printf '%s' "$msg" | grep -Eq '^(feat|fix|refactor|chore|docs|test|ci|build|perf|style|revert)(\([^)]*\))?!?: '; then
    echo "Blocked by claude-guard-destructive: commit message must use a conventional prefix (feat:, fix:, refactor:, chore:, docs:, ...). Got: ${msg%%$'\n'*}" >&2
    exit 2
  fi
fi

# Merging main into a feature branch is banned by CLAUDE.md (rebase instead);
# this is the deterministic backstop.
if printf '%s' "$cmd" | grep -Eq 'git[[:space:]]+merge[[:space:]]+(--[a-z-]+[[:space:]]+)*(origin/)?(main|master)($|[[:space:]])'; then
  echo "Blocked by claude-guard-destructive: never merge main into a branch - rebase instead (git fetch origin && git rebase origin/main)." >&2
  exit 2
fi

# AI attribution in commits/PRs ("no AI attribution anywhere" is a hard rule in
# CLAUDE.md; prose is advisory, this is the guarantee). Matches only the precise
# attribution markers so commits that merely mention Claude/CLAUDE.md pass.
if printf '%s' "$cmd" | grep -Eq '(git[[:space:]]+commit|gh[[:space:]]+pr[[:space:]]+(create|edit))' &&
   printf '%s' "$cmd" | grep -Eiq 'co-authored-by:[[:space:]]*claude|generated with[[:space:]]*\[?claude'; then
  echo "Blocked by claude-guard-destructive: AI attribution in commit messages or PR bodies is denied (no Co-Authored-By/Generated-with footers)." >&2
  exit 2
fi

exit 0
